# Server-only. Do not prefix any of these with NEXT_PUBLIC_.
# No values in this file. Set them in the host environment.
#
# LEAD_SINK: sheets | log | noop
# Default: sheets when VERCEL_ENV is production or preview, otherwise log.
# log and noop are refused when VERCEL_ENV=production.
LEAD_SINK=
GOOGLE_SHEETS_SPREADSHEET_ID=
# Production tab: Leads!A:I
# Preview tab: Preview!A:I
# Header: received_at | lead_id | name | email | phone | package | message | source_page | consent_version
GOOGLE_SHEETS_RANGE=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
