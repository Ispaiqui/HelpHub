{
  "name": "helphub-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Site e hub digital da HelpHub — landing pages, demonstrações e presença online.",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "scripts\\dev.cmd",
    "dev:win": "scripts\\dev.cmd",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm run lint",
    "optimize:brand": "node scripts/optimize-brand-mark.mjs",
    "capture:about-steps": "node scripts/capture-about-steps.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@gsap/react": "2.1.2",
    "@helphub/crm": "workspace:*",
    "@helphub/design-system": "github:Ispaiqui/helphub-design-system",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^13.2.0",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "lucide-react": "^1.34.0",
    "next": "16.3.2",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "three": "0.186.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "playwright-core": "^1.63.0",
    "shadcn": "^4.19.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
